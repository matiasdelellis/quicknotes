<div class="note-grid-item">
	<div class="quicknote noselect {{#if sharedBy.length}}shared{{/if}} {{#if sharedWith.length}}shareowner{{/if}}" style="background-color: {{color}}" data-id="{{ id }}" data-pinned={{#if isPinned}}1{{else}}0{{/if}} data-timestamp="{{ timestamp }}" >
		<div class='note-header'>
			<div class='note-attachts'>
				{{#each attachments}}
					<div class='note-attach-grid'>
						<div class="attach-preview note-attach" attach-file-id="{{file_id}}" data-background-image="{{preview_url}}"></div>
					</div>
				{{/each}}
			</div>
		</div>
		<div class='note-body'>
			{{#unless trashView}}
				{{#if isPinned}}
					<div class="icon-header-note icon-pinned fixed-header-icon" title="{{t "quicknotes" "Unpin note"}}"></div>
				{{else}}
					<div class="icon-header-note icon-pin hide-header-icon" title="{{t "quicknotes" "Pin note"}}"></div>
				{{/if}}
				{{#if archivedAt}}
					<div class="icon-header-note icon-archived fixed-header-icon" title="{{t "quicknotes" "Unarchive"}}"></div>
				{{else}}
					<div class="icon-header-note hide-header-icon icon-archived" title="{{t "quicknotes" "Archive note"}}"></div>
				{{/if}}
			{{/unless}}
			{{#if deletedAt}}
				<div class="icon-header-note icon-delete-note fixed-header-icon" title="{{t "quicknotes" "Restore"}}"></div>
			{{else}}
				<div class="icon-header-note hide-header-icon icon-delete-note" title="{{t "quicknotes" "Move to trash"}}"></div>
			{{/if}}
			<div class='note-title'>
				{{{ title }}}
			</div>
			<div class='note-content'>
				{{{ content }}}
			</div>
			<div class='note-reminder'>
				{{#if reminderAt}}
					{{#if reminderNotifiedAt}}
						<div class="slim-reminder slim-reminder-sent" reminder-at="{{ reminderAt }}" title="{{t "quicknotes" "Reminder already sent"}}">{{ reminderLabel reminderAt }}</div>
					{{else}}
						<div class="slim-reminder" reminder-at="{{ reminderAt }}" title="{{t "quicknotes" "Reminder"}}">{{ reminderLabel reminderAt }}</div>
					{{/if}}
				{{/if}}
			</div>
			<div class='note-shares'>
				{{#each sharedWith}}
					<div class="slim-share" share-id="{{ shared_user }}" title="Shared with {{ display_name }}">{{{ display_name }}}</div>
				{{/each}}
			</div>
			<div class='note-tags'>
				{{#each tags}}
					<div class="slim-tag" tag-id="{{ id }}">{{{ name }}}</div>
				{{/each}}
			</div>
		<div>
	</div>
</div>