{{#if notes.length}}
{{! The trash empties itself a week after each note landed there. This is for
    whoever would rather not wait, and it is the only place it shows up. }}
{{#if trashView}}
<div id="trash-bar">
	<button id="empty-trash" class="icon-delete">{{emptyTrashTxt}}</button>
</div>
{{/if}}
<div id="notes-grid-div" class="notes-grid">
	{{#each notes}}
	<div class="note-grid-item">
		<div class="quicknote noselect {{#if sharedBy}}shared{{/if}} {{#if sharedByMe}}shareowner{{/if}}" style="background-color: {{color}}" data-id="{{ id }}" data-pinned={{#if isPinned}}1{{else}}0{{/if}} data-timestamp="{{ timestamp }}" >
			<div class='note-header'>
				<div class='note-attachts' data-count="{{attachments.length}}" {{{attachtsExtra attachments}}}>
					{{#each attachments}}
						<div class='note-attach-grid'>
							<div class="attach-preview note-attach {{#unless has_preview}}attach-is-icon{{/unless}}" attach-file-id="{{file_id}}" data-background-image="{{preview_url}}"></div>
						</div>
					{{/each}}
				</div>
			</div>
			<div class='note-body'>
				{{#if sharedBy}}
					<div class="icon-header-note icon-qn-share" title="{{tSB sharedBy.displayName}}"></div>
					{{#if canEdit}}
						{{#if isPinned}}
							<div class="icon-header-note icon-pinned fixed-header-icon" title="{{t "quicknotes" "Unpin note"}}"></div>
						{{else}}
							<div class="icon-header-note icon-pin hide-header-icon" title="{{t "quicknotes" "Pin note"}}"></div>
						{{/if}}
					{{/if}}
					{{#if ../allView}}
						<div class="icon-header-note hide-header-icon icon-archived" title="{{t "quicknotes" "Archive note"}}"></div>
					{{else if ../archivedView}}
						<div class="icon-header-note hide-header-icon icon-unarchive" title="{{t "quicknotes" "Unarchive"}}"></div>
					{{/if}}
					{{! A note that reaches you through a group is not yours to
					    leave — the share belongs to the group — so archiving is
					    the only way out of your own grid. }}
					{{#if canLeave}}
						<div class="icon-header-note hide-header-icon icon-delete-note" title="{{t "quicknotes" "Leave this shared note"}}"></div>
					{{/if}}
				{{else}}
					{{#if ../allView}}
						{{#if isPinned}}
							<div class="icon-header-note icon-pinned fixed-header-icon" title="{{t "quicknotes" "Unpin note"}}"></div>
						{{else}}
							<div class="icon-header-note icon-pin hide-header-icon" title="{{t "quicknotes" "Pin note"}}"></div>
						{{/if}}
						<div class="icon-header-note hide-header-icon icon-archived" title="{{t "quicknotes" "Archive note"}}"></div>
						<div class="icon-header-note hide-header-icon icon-delete-note" title="{{t "quicknotes" "Move to trash"}}"></div>
					{{else if ../archivedView}}
						{{#if isPinned}}
							<div class="icon-header-note icon-pinned fixed-header-icon" title="{{t "quicknotes" "Pinned"}}"></div>
						{{/if}}
						<div class="icon-header-note hide-header-icon icon-unarchive" title="{{t "quicknotes" "Unarchive"}}"></div>
					{{else if ../trashView}}
						<div class="icon-header-note icon-restore fixed-header-icon" title="{{t "quicknotes" "Restore"}}"></div>
						<div class="icon-header-note hide-header-icon icon-delete-note" title="{{t "quicknotes" "Delete permanently"}}"></div>
					{{/if}}
				{{/if}}
				<div class='note-title'>
					{{{ title }}}
				</div>
				<div class='note-content'>
					{{{ content }}}
				</div>
				<div class='note-reminder'>
					{{#if reminderAt}}
						{{#if reminderNotifiedAt}}
							<div class="slim-reminder slim-reminder-sent" reminder-at="{{ reminderAt }}" title="{{t "quicknotes" "Reminder already sent"}}">{{ reminderLabel reminderAt }}</div>
						{{else}}
							<div class="slim-reminder" reminder-at="{{ reminderAt }}" title="{{t "quicknotes" "Reminder"}}">{{ reminderLabel reminderAt }}</div>
						{{/if}}
					{{/if}}
				</div>
				<div class='note-shares'>
					{{#each sharedWith}}
						<div class="slim-share {{#if isGroup}}slim-share-group{{/if}} {{#if canEdit}}slim-share-editable{{/if}}" share-id="{{ id }}" title="{{tShare this}}">{{ displayName }}</div>
					{{/each}}
				</div>
				<div class='note-tags'>
					{{#each tags}}
						<div class='slim-tag' tag-id="{{ id }}">
							{{{ name }}}
						</div>
					{{/each}}
				</div>
			</div>
		</div>
	</div>
	{{/each}}
</div>
<div id="no-matches" class="emptycontent">
	<div class="icon-qn-search svg"></div>
	<h3>{{ noMatchesMsg }}</h3>
</div>
<div id="modal-note-div" class="hide-modal-note modal-note-background">
	<div class="modal-content">
		<div class="quicknote note-active" style="background-color: #F7EB96" data-id="-1">
			<div class='note-header'>
				<div class='note-attachts'></div>
			</div>
			<div class='note-body'>
				<div class="icon-header-note icon-pin fixed-header-icon" title="{{t "quicknotes" "Pin note"}}"></div>
				<div contenteditable="true" id='title-editable' class='note-title' data-placeholder="{{t "quicknotes" "Title"}}"></div>
				<div contenteditable="true" id='content-editable' class='note-content'></div>
				<div class='note-reminder'></div>
				<div class='note-shares'></div>
				<div class='note-tags'></div>
			</div>
			<div class="note-editable-options">
				<div class="colors-toolbar">
					<button id='color-button' class='round-tool-button'>
						<div class="icon-toggle-background" title="{{t "quicknotes" "Colors"}}"></div>
					</button>
					<button id='share-button' class='round-tool-button'>
						<div class="icon-qn-shared" title="{{t "quicknotes" "Share note"}}"></div>
					</button>
					<button id='tag-button' class='round-tool-button'>
						<div class="icon-tag" title="{{t "quicknotes" "Tags"}}"></div>
					</button>
					<button id='reminder-button' class='round-tool-button reminder-button'>
						<div class="icon-qn-reminder" title="{{t "quicknotes" "Remind me"}}"></div>
					</button>
					<button id='attach-button' class='round-tool-button'>
						<div class="icon-picture" title="{{t "quicknotes" "Attach file"}}"></div>
					</button>
				</div>
				<div class="buttons-toolbar">
					<button id='cancel-button'>
						{{ cancelTxt }}
					</button>
					<button id='save-button'>
						{{ saveTxt }}
					</button>
					<button id='close-button'>{{t "quicknotes" "Close"}}</button>
				</div>
				<div style="clear: both;"></div>
			</div>
			<div class="note-noneditable-options">
				<div class="colors-toolbar">
					<button class='round-tool-button reminder-button'>
						<div class="icon-qn-reminder" title="{{t "quicknotes" "Remind me"}}"></div>
					</button>
				</div>
				<div class="buttons-toolbar">
					<button id='close-button'>{{t "quicknotes" "Close"}}</button>
				</div>
				<div style="clear: both;"></div>
			</div>
		</div>
	</div>
</div>
{{else if loaded}}
<div class="emptycontent">
	<div class="{{ emptyIcon }} svg"></div>
	<h3>
		{{ emptyMsg }}
	</h3>
</div>
{{else}}
<div class="emptycontent">
	<div class="icon-quicknotes svg"></div>
	<h3>
		{{loadingMsg}}
	</h3>
	<img class="loadingimport" src="{{loadingIcon}}" />
</div>
{{/if}}
